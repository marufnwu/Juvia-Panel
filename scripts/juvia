#!/bin/bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_step() { echo -e "${BLUE}[STEP]${NC} $1"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

show_help() {
    cat <<EOF
Juvia Panel CLI

Usage: juvia <command> [options]

Commands:
  install     Install or re-install Juvia Panel
  update      Update Juvia Panel to latest or specified version
  uninstall   Remove Juvia Panel from the system
  reset       Reset panel database to fresh state

Options:
  --help      Show this help message

Run 'juvia <command> --help' for more information on a command.
EOF
}

case "${1:-}" in
    install)
        shift
        exec "$SCRIPT_DIR/install.sh" "$@"
        ;;
    update)
        shift
        exec "$SCRIPT_DIR/update.sh" "$@"
        ;;
    uninstall)
        shift
        exec "$SCRIPT_DIR/uninstall.sh" "$@"
        ;;
    reset)
        shift
        exec "$SCRIPT_DIR/reset.sh" "$@"
        ;;
    --help|-h|"")
        show_help
        ;;
    *)
        log_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac