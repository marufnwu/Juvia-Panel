{
    admin unix//var/run/panel/caddy-admin.sock
    log {
        level INFO
    }
}

:2053 {
    # WebSocket — must come before generic /api handler
    handle /api/v1/stream {
        reverse_proxy localhost:9090 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # API routes — proxy to Go backend
    handle /api* {
        reverse_proxy localhost:9090
    }

    # Health check
    handle /health {
        reverse_proxy localhost:9090
    }

    # Everything else — proxy to Next.js server
    # Next.js handles all UI routes, middleware, and static file serving
    handle {
        reverse_proxy localhost:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
