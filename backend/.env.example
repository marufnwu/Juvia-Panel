# Server Panel Environment Variables
# Copy this file to .env and fill in the values

# Application
PANEL_ENV=development
PANEL_LOG_LEVEL=info

# Paths
PANEL_DATA_DIR=/var/panel
PANEL_CONFIG_DIR=/etc/panel
PANEL_AGENT_SOCKET=/var/run/panel/agent.sock

# API Server
PANEL_API_PORT=8080
PANEL_API_HOST=0.0.0.0

# Security - Generated on first run if empty
PANEL_JWT_SECRET=
PANEL_MASTER_KEY=

# Database
# For SQLite (default):
PANEL_DB_PATH=/var/panel/panel.db

# For libsql/Turso (production):
# PANEL_DB_URL=file:/var/panel/panel.db?mode=rwc
# PANEL_DB_AUTH_TOKEN=

# SSL (Let's Encrypt)
PANEL_SSL_EMAIL=admin@example.com

# Docker
PANEL_DOCKER_SOCKET=/var/run/docker.sock

# CORS - comma-separated origins
PANEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3 Backup (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=panel-backups