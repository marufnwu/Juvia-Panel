{
    admin off
    log {
        level INFO
    }
}

# Serve UI and proxy API
:2053 {
    # Next.js static files (_next/static, etc.)
    handle /_next/* {
        file_server {
            root /opt/panel/ui/.next/server/app
        }
    }

    # Static assets
    handle /static/* {
        file_server {
            root /opt/panel/ui/.next/server/app
        }
    }

    # Proxy API requests to internal API server
    handle /api/* {
        reverse_proxy localhost:9090
    }

    # Health check
    handle /health {
        reverse_proxy localhost:9090
    }

    # SPA fallback - serve index.html for all other requests
    handle {
        try_files {path} /index.html
        file_server {
            root /opt/panel/ui/.next/server/app
        }
    }
}