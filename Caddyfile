{
    admin off
    log {
        level INFO
    }
}

# Panel UI on port 2053 with API proxy to 9090
:2053 {
    root * /opt/panel/ui
    encode gzip
    file_server

    @spa {
        not {
            file {
                try_files {path} {path}/ /index.html
            }
        }
    }
    rewrite @spa /index.html

    # Proxy API requests to internal API server on port 9090
    handle /api/* {
        reverse_proxy localhost:9090
    }

    # Health check
    handle /health {
        reverse_proxy localhost:9090
    }
}